# Toranaado's EditorConfig Settings
# Version: 1.2.0 (Edited: 2026/05/20)
# http://editorconfig.org

root = true

[*]
charset                  = utf-8
end_of_line              = crlf
indent_size              = 4
indent_style             = space
insert_final_newline     = true
max_line_length          = 120
tab_width                = 4
trim_trailing_whitespace = true

[{*.min.{css,js},*.{diff,patch}}]
indent_style             = unset
insert_final_newline     = unset
